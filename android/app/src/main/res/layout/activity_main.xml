<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:padding="16dp"
            android:background="#1E1E1E" />

        <!-- Google Account -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_account"
            android:textColor="#888888"
            android:textSize="12sp"
            android:textAllCaps="true"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="24dp" />

        <TextView
            android:id="@+id/tv_account"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#CCCCCC"
            android:textSize="14sp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="4dp"
            android:text="@string/not_signed_in" />

        <Button
            android:id="@+id/btn_sign_in"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="8dp"
            android:text="@string/sign_in_google"
            android:backgroundTint="#4285F4"
            android:textColor="#FFFFFF" />

        <!-- Spreadsheet ID -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_spreadsheet"
            android:textColor="#888888"
            android:textSize="12sp"
            android:textAllCaps="true"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="32dp" />

        <EditText
            android:id="@+id/et_spreadsheet_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="8dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#666666"
            android:hint="@string/spreadsheet_id_hint"
            android:inputType="text"
            android:background="#2C2C2C"
            android:padding="12dp" />

        <Button
            android:id="@+id/btn_save_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="8dp"
            android:text="@string/save"
            android:backgroundTint="#4CAF50"
            android:textColor="#FFFFFF" />

        <!-- Deepgram API Key -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Deepgram API Key"
            android:textColor="#888888"
            android:textSize="12sp"
            android:textAllCaps="true"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="32dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Get a free key at deepgram.com"
            android:textColor="#666666"
            android:textSize="12sp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="2dp" />

        <EditText
            android:id="@+id/et_deepgram_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="8dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#666666"
            android:hint="Paste API key here"
            android:inputType="textPassword"
            android:background="#2C2C2C"
            android:padding="12dp"
            android:fontFamily="monospace"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_save_deepgram_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="8dp"
            android:text="Save API Key"
            android:backgroundTint="#4CAF50"
            android:textColor="#FFFFFF" />

        <!-- Speech Language -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Speech Language"
            android:textColor="#888888"
            android:textSize="12sp"
            android:textAllCaps="true"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="32dp" />

        <RadioGroup
            android:id="@+id/rg_language"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="8dp">

            <RadioButton
                android:id="@+id/rb_lang_both"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hebrew + English"
                android:textColor="#CCCCCC"
                android:checked="true" />

            <RadioButton
                android:id="@+id/rb_lang_hebrew"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hebrew only  (עברית בלבד)"
                android:textColor="#CCCCCC" />

            <RadioButton
                android:id="@+id/rb_lang_english"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="English only"
                android:textColor="#CCCCCC" />

        </RadioGroup>

        <!-- View Expenses -->
        <Button
            android:id="@+id/btn_view_expenses"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="32dp"
            android:text="@string/view_expenses"
            android:backgroundTint="#333333"
            android:textColor="#FFFFFF" />

    </LinearLayout>
</ScrollView>
